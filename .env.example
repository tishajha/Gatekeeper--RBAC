# Copy this file to .env and adjust values as needed.

# JWT signing secret. In production, generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string-in-production

# JWT signing algorithm
ALGORITHM=HS256

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database connection string. SQLite is used by default for zero-setup runs.
DATABASE_URL=sqlite:///./gatekeeper.db

# Default admin credentials (used by the seed script)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
